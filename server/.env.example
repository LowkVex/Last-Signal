# ============================================================
# THE LAST SIGNAL — game server environment
# Copy to `.env` (same folder) for local runs, or set these as
# environment variables in the Render dashboard for production.
# NEVER commit the real .env file (it is gitignored).
# ============================================================

# ---- port / host ----
# Render injects PORT automatically. Locally, 3000 is the default.
PORT=3000
HOST=0.0.0.0

# ---- Supabase (project: nmgrpmpmhsapcbbnwver) ----
SUPABASE_URL=https://nmgrpmpmhsapcbbnwver.supabase.co
# The publishable key is safe for clients; the server also uses it for JWKS/GoTrue validation.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_Ar49zMbSu5KCu3u0T077LA_3AHDNFE3
# OPTIONAL but recommended: your Supabase SECRET key (Dashboard -> API Keys -> secret).
# With it, the game server itself writes milestone progress for the whole room.
# Without it, each client saves its OWN progress row directly (protected by RLS).
# This value must NEVER appear in client code or the repository.
SUPABASE_SECRET_KEY=

# ---- auth mode ----
# strict = only real Supabase tokens are accepted (USE THIS IN PRODUCTION)
# dev    = also accepts "dev-guest:<uuid>" tokens for local testing WITHOUT Supabase.
#          The server refuses dev mode when NODE_ENV=production.
AUTH_MODE=strict

# ---- CORS ----
# Comma-separated list of allowed browser origins, or * for any.
# Same-origin deployments (the server also serves the game) need no change.
CORS_ORIGIN=*

# ---- WebRTC voice: STUN / TURN ----
# Public STUN works out of the box. For players behind strict NATs/firewalls
# you MUST add a TURN relay (e.g. a free Metered/OpenRelay account or your own coturn).
# These credentials stay on the server; clients receive them at runtime over an
# authenticated socket — they are never hardcoded into the game files.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
